# YouTube Data API v3 key (create in Google Cloud Console: https://console.cloud.google.com)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Optional Reddit API credentials (PullPush ingestion needs no auth)
REDDIT_CLIENT_ID=your_client_id_here
REDDIT_CLIENT_SECRET=your_client_secret_here
REDDIT_USER_AGENT=kh4-demand-intel by u/your_username
